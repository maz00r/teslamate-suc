            "update": {
              "datasource": "${ds}",
              "payload": {
                "editorMode": "code",
                "format": "table",
                "rawQuery": true,
                "rawSql": "WITH u AS (\n  UPDATE charging_processes SET cost = NULLIF(NULLIF(${payload.cost:sqlstring}, ''), 'null')::numeric\n   WHERE id = ${payload.id}\n     AND NOT EXISTS (SELECT 1 FROM suc.cost_written WHERE charging_process_id = ${payload.id})\n  RETURNING id)\nSELECT CASE WHEN count(*) = 1 THEN 1\n            ELSE ('Koszt ladowania prowadzi dodatek TeslaMate SuC - zmien go w panelu dodatku. Zapisano: ' || count(*))::int\n       END AS ok\n  FROM u",
                "refId": "A"
              }
            }
          }
