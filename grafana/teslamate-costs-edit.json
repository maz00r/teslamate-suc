      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${ds}"
          },
          "rawSql": "SELECT cp.id, cp.start_date AS \"Start\", coalesce(c.name, 'Auto ' || c.id) AS \"Auto\",\n       coalesce(g.name, a.name, nullif(concat_ws(' ', a.road, a.house_number), ''), a.display_name) AS \"Miejsce\",\n       cp.charge_energy_added AS \"kWh\", cp.cost,\n       CASE cw.provider WHEN 'tesla' THEN 'SuC: Tesla' WHEN 'greenway' THEN 'SuC: Greenway'\n            WHEN 'manual' THEN 'SuC: ręczny' ELSE '' END AS \"Koszt z dodatku\"\n  FROM charging_processes cp\n  JOIN cars c ON c.id = cp.car_id\n  LEFT JOIN addresses a ON a.id = cp.address_id\n  LEFT JOIN geofences g ON g.id = cp.geofence_id\n  LEFT JOIN suc.cost_written cw ON cw.charging_process_id = cp.id\n WHERE $__timeFilter(cp.start_date) AND cp.end_date IS NOT NULL AND cp.car_id = ANY(ARRAY[$car_id]::int[])\n ORDER BY cp.start_date DESC",
          "format": "table",
          "editorMode": "code"
        }
      ],
